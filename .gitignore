# Only source code, documentation and example inputs are distributed.
/*
!/.gitignore
!/calc_molecule.py
!/calc_diatomic_mol.py
!/generate_orbitals.py
!/build_hpc_bundle.py
!/*.md
!/pyproject.toml
!/requirements-*.txt
!/scgvb/
!/tools/
!/examples/
!/hpc/

/scgvb/**
!/scgvb/**/
!/scgvb/**/*.py
!/scgvb/**/*.md
!/scgvb/io/orbital_viewer.html
/tools/*
!/tools/*.py
/examples/*
!/examples/*.xyz
!/examples/legacy_generate_cube.py
!/examples/inputs/
/examples/inputs/*
!/examples/inputs/*.toml
/hpc/*
!/hpc/*.py
!/hpc/*.sh

# Cluster-specific batch scripts are local only.
/hpc/rikyu*
/hpc/*.sbatch
# This input resumes a specific rikyu job and writes to its local run directory.
/examples/inputs/b2h6_geometry_bobyqa.toml

# Tests and local artifacts stay on this machine.
test.py
test_*.py
*_test.py
tests/
__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
*.log
*.old
*.npz
*.npy
*.cube
*.json
*.jsonl
runs/
dist/
